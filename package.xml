<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dexi_oak_vio</name>
  <version>0.1.0</version>
  <description>Oak-D Lite VIO to PX4 bridge for position hold</description>
  <maintainer email="db@droneblocks.io">Dennis Baldwin</maintainer>
  <license>MIT</license>

  <!-- Core ROS2 -->
  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>

  <!-- Oak-D -->
  <depend>depthai_ros_driver</depend>
  <depend>depthai_ros_msgs</depend>

  <!-- PX4 (uXRCE-DDS) -->
  <depend>px4_msgs</depend>

  <!-- Optional: RTAB-Map (for full VIO) -->
  <exec_depend>rtabmap_odom</exec_depend>

  <!-- Optional: robot_localization (for ROS2 fusion) -->
  <exec_depend>robot_localization</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
